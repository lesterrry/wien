# Copy to .env and set a persistent token, for example: openssl rand -hex 32
STRUDEL_RAG_BEARER_TOKEN=

# Required for indexing/search with the default embedding endpoint.
# The services can start with an empty index without this key.
OPENAI_API_KEY=

# Optional host port overrides:
# WIEN_SERVER_PORT=3001
# STRUDEL_RAG_PORT=50051

# Optional host paths; Compose mounts these files read-only.
# WIEN_CODEX_AUTH_FILE=/absolute/path/to/auth.json
# WIEN_SERVER_CONFIG=./server/config.toml
# STRUDEL_RAG_CONFIG=./skill/config.toml
# RUST_LOG=info

# Optional corporate network support (Docker VM must have IPv6 connectivity):
# WIEN_DOCKER_IPV6=true
# COMPOSE_FILE=compose.yaml:compose.ca.yaml
# WIEN_CA_BUNDLE=./.local/ca-bundle.pem

# Optional embedding endpoint overrides:
# STRUDEL_RAG_EMBEDDING_BASE_URL=http://host.docker.internal:8080/v1
# STRUDEL_RAG_EMBEDDING_MODEL=your-model

# Optional embedding key override (takes precedence over OPENAI_API_KEY):
# STRUDEL_RAG_EMBEDDING_API_KEY=
