{
  "editor.defaultFormatter": "biomejs.biome",
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.biome": "explicit",
    "source.organizeImports.biome": "explicit"
  },
  "files.associations": {
    "*.strudel": "javascript",
    "Justfile": "just"
  },
  "search.exclude": {
    "client/out": true,
    "client/release": true
  },
  "biome.lsp.bin": "client/node_modules/@biomejs/biome/bin/biome",
  "biome.configurationPath": "client/biome.json"
}
