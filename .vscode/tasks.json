{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Wien: Run",
      "dependsOn": ["Wien: Run client", "Wien: Run server"],
      "dependsOrder": "parallel",
      "problemMatcher": [],
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "Wien: Run client",
      "type": "shell",
      "command": "just run-client",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "wien-dev"
      }
    },
    {
      "label": "Wien: Run server",
      "type": "shell",
      "command": "just run-server",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": ["$rustc"],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "wien-dev"
      }
    },
    {
      "label": "Wien: Test",
      "type": "shell",
      "command": "just test",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": {
        "kind": "test",
        "isDefault": true
      }
    },
    {
      "label": "Wien: Build client",
      "type": "shell",
      "command": "just build-client",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": false
      }
    },
    {
      "label": "Wien: Build server",
      "type": "shell",
      "command": "just build-server",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": ["$rustc"]
    }
  ]
}
