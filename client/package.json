{
  "name": "@wien/client",
  "version": "0.1.0",
  "private": true,
  "description": "A local workspace for making music with Strudel",
  "author": "Wien",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "check": "biome check . && pnpm typecheck",
    "typecheck": "tsc --noEmit",
    "format": "biome check --write .",
    "test": "pnpm check && pnpm test:unit",
    "test:unit": "node --import tsx --test src/main/project-fs.test.ts src/shared/modules.test.ts src/shared/controls.test.ts && pnpm test:modules",
    "test:smoke": "pnpm build && node scripts/smoke.mjs",
    "build": "pnpm typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "package": "pnpm build && electron-builder --dir",
    "test:modules": "esbuild src/renderer/src/module-compiler.test.ts --bundle --platform=node --main-fields=module,main --format=cjs --outfile=out/tests/modules.cjs && node --test out/tests/modules.cjs"
  },
  "dependencies": {
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@strudel/codemirror": "^1.3.0",
    "@strudel/core": "^1.2.6",
    "@strudel/mini": "^1.2.6",
    "@strudel/tonal": "^1.2.6",
    "@strudel/transpiler": "^1.2.6",
    "@strudel/webaudio": "^1.3.0",
    "acorn": "^8.19.0",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-arborist": "4.0.1",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "6.0.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.3.7"
  },
  "packageManager": "pnpm@11.20.0"
}
