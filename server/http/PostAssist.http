# Generated by just generate. Do not edit; copy to a separate .http file for experiments.

@baseUrl = http://127.0.0.1:3001
@contentType = application/json
@sessionToken = paste-token-from-login

#####################################################################################################
### Request: POST /v1/assist
### Summary: Ask the editor assistant; selection is context, edits replace the entire current file.
#####################################################################################################


POST {{baseUrl}}/v1/assist
Content-Type: {{contentType}}
Authorization: Bearer {{sessionToken}}

{
  "file": {
    "content": "note(\"a1\").s(\"sawtooth\").gain(0.2)",
    "cursor": {
      "anchor": 0,
      "head": 10
    },
    "path": "first-light.strudel"
  },
  "prompt": "Make the bass softer. Reply briefly."
}
