@baseUrl = http://127.0.0.1:3001
@contentType = application/json
@sessionToken = paste-token-from-login

############################################################################################
### Request: POST /users/me/password
### Summary: Revoke all previous sessions and return a replacement for the current device.
############################################################################################


POST {{baseUrl}}/users/me/password
Content-Type: {{contentType}}
Authorization: Bearer {{sessionToken}}

{
  "current_password": "choose a long password",
  "new_password": "choose another long password"
}
