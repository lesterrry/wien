{
  "openapi": "3.1.0",
  "info": {
    "title": "Wien local AI server",
    "version": "0.1.0"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:3001"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Check server health without calling the model.",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Server is running; does not probe model authentication",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/v1/generate": {
      "post": {
        "summary": "Generate a completed text response using the server's configured provider.",
        "operationId": "generate",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GenerateRequest"
              },
              "example": {
                "options": {
                  "model": "gpt-6.1-sol",
                  "reasoning_effort": "low"
                },
                "text": "Hello!"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Completed model response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModelResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid JSON, text, model, or options",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "403": {
            "description": "Non-local browser origin",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "413": {
            "description": "Request body too large",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "429": {
            "description": "Provider usage limit",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "502": {
            "description": "Upstream error or incomplete response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "503": {
            "description": "Local Codex login required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "504": {
            "description": "Provider timeout",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApiError": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "GenerateRequest": {
        "type": "object",
        "required": [
          "text",
          "options"
        ],
        "properties": {
          "options": {
            "$ref": "#/components/schemas/ModelOptions"
          },
          "text": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "ModelOptions": {
        "type": "object",
        "description": "Explicitly supported model settings. Unknown settings are rejected, not ignored.",
        "required": [
          "model"
        ],
        "properties": {
          "instructions": {
            "type": [
              "string",
              "null"
            ]
          },
          "model": {
            "type": "string",
            "description": "Model slug available to your account; no implicit model substitution."
          },
          "reasoning_effort": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/ReasoningEffort"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false
      },
      "ModelResponse": {
        "type": "object",
        "required": [
          "id",
          "model",
          "text"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "usage": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Usage"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "ReasoningEffort": {
        "type": "string",
        "enum": [
          "none",
          "minimal",
          "low",
          "medium",
          "high",
          "xhigh",
          "max",
          "ultra"
        ]
      },
      "Usage": {
        "type": "object",
        "required": [
          "input_tokens",
          "output_tokens",
          "total_tokens"
        ],
        "properties": {
          "input_tokens": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "output_tokens": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "total_tokens": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        }
      }
    }
  }
}
