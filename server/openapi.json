{
  "openapi": "3.1.0",
  "info": {
    "title": "Wien AI server",
    "version": "0.1.0"
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Check server health without calling the model.",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Server is running; does not probe model authentication",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/ready": {
      "get": {
        "summary": "Dependency readiness without a paid model or embedding request.",
        "operationId": "ready",
        "responses": {
          "200": {
            "description": "RAG corpus ready; external APIs are not probed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                }
              }
            }
          },
          "503": {
            "description": "RAG unavailable or corpus not ready",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/assist": {
      "post": {
        "summary": "Ask the editor assistant; selection is context, edits replace the entire current file.",
        "operationId": "assist",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AssistRequest"
              },
              "example": {
                "file": {
                  "content": "note(\"a1\").s(\"sawtooth\").gain(0.2)",
                  "cursor": {
                    "anchor": 0,
                    "head": 10
                  },
                  "path": "first-light.strudel"
                },
                "prompt": "Make the bass softer. Reply briefly."
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Short answer and optional complete replacement code",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssistResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid prompt, file or cursor offsets",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "403": {
            "description": "Non-local browser origin",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "413": {
            "description": "Request body too large",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "429": {
            "description": "Assistant busy (assistant_busy, Retry-After: 2) or provider usage limit",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "502": {
            "description": "Invalid or incomplete model response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "503": {
            "description": "Codex login or RAG unavailable; retrieval index may not be ready",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "504": {
            "description": "Provider timeout",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/generate": {
      "post": {
        "summary": "Generate a completed text response using the server's configured provider.",
        "operationId": "generate",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GenerateRequest"
              },
              "example": {
                "text": "Hello!"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Completed model response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModelResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid JSON or text",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "403": {
            "description": "Non-local browser origin",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "413": {
            "description": "Request body too large",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "429": {
            "description": "Provider usage limit",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "502": {
            "description": "Upstream error or incomplete response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "503": {
            "description": "Provider credentials required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "504": {
            "description": "Provider timeout",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApiError": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "AssistRequest": {
        "type": "object",
        "required": [
          "prompt",
          "file"
        ],
        "properties": {
          "file": {
            "$ref": "#/components/schemas/FileContext"
          },
          "prompt": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "AssistResponse": {
        "type": "object",
        "required": [
          "message"
        ],
        "properties": {
          "code": {
            "type": [
              "string",
              "null"
            ],
            "description": "Entire replacement file, or null for an answer without an edit."
          },
          "message": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "Cursor": {
        "type": "object",
        "required": [
          "anchor",
          "head"
        ],
        "properties": {
          "anchor": {
            "type": "integer",
            "description": "Zero-based UTF-16 offset. Different anchor/head values indicate a selection.",
            "minimum": 0
          },
          "head": {
            "type": "integer",
            "description": "Zero-based UTF-16 offset of the active end of the selection (caret).",
            "minimum": 0
          }
        },
        "additionalProperties": false
      },
      "FileContext": {
        "type": "object",
        "required": [
          "path",
          "content",
          "cursor"
        ],
        "properties": {
          "content": {
            "type": "string"
          },
          "cursor": {
            "$ref": "#/components/schemas/Cursor"
          },
          "path": {
            "type": "string",
            "description": "Project-relative path; context only, never used for filesystem access."
          }
        },
        "additionalProperties": false
      },
      "GenerateRequest": {
        "type": "object",
        "required": [
          "text"
        ],
        "properties": {
          "text": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "ModelResponse": {
        "type": "object",
        "required": [
          "id",
          "model",
          "text"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "usage": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Usage"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "Readiness": {
        "type": "object",
        "required": [
          "ready"
        ],
        "properties": {
          "ready": {
            "type": "boolean"
          }
        }
      },
      "Usage": {
        "type": "object",
        "required": [
          "input_tokens",
          "output_tokens",
          "total_tokens"
        ],
        "properties": {
          "input_tokens": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "output_tokens": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "total_tokens": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        }
      }
    }
  }
}
