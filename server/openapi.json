{
  "openapi": "3.1.0",
  "info": {
    "title": "Wien AI server",
    "version": "0.1.0"
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/auth/login": {
      "post": {
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Credentials"
              },
              "example": {
                "password": "choose a long password",
                "username": "music_maker"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignedIn"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "operationId": "logout",
        "responses": {
          "204": {
            "description": "Session revoked"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": [
          {
            "session": []
          },
          {
            "browser_session": []
          }
        ]
      }
    },
    "/auth/register": {
      "post": {
        "summary": "Register on the website with a verified Turnstile token; creates a cookie session.",
        "operationId": "register",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Registration"
              },
              "example": {
                "password": "choose a long password",
                "turnstile_token": "token from the Turnstile widget",
                "username": "music_maker"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignedIn"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/auth/registration": {
      "get": {
        "operationId": "registration_config",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegistrationConfig"
                }
              }
            }
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Check server health without calling the model.",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Server is running; does not probe model authentication",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/ready": {
      "get": {
        "summary": "Dependency readiness without a paid model or embedding request.",
        "operationId": "ready",
        "responses": {
          "200": {
            "description": "PostgreSQL and RAG corpus ready; external APIs are not probed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                }
              }
            }
          },
          "503": {
            "description": "PostgreSQL or RAG unavailable, or corpus not ready",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/users/me": {
      "get": {
        "operationId": "profile",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Profile"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": [
          {
            "session": []
          },
          {
            "browser_session": []
          }
        ]
      }
    },
    "/users/me/password": {
      "post": {
        "summary": "Revoke all previous sessions and return a replacement for the current device.",
        "operationId": "change_password",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangePassword"
              },
              "example": {
                "current_password": "choose a long password",
                "new_password": "choose another long password"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignedIn"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": [
          {
            "session": []
          },
          {
            "browser_session": []
          }
        ]
      }
    },
    "/v1/assist": {
      "post": {
        "summary": "Ask the editor assistant; selection is context, edits replace the entire current file.",
        "operationId": "assist",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AssistRequest"
              },
              "example": {
                "file": {
                  "content": "note(\"a1\").s(\"sawtooth\").gain(0.2)",
                  "cursor": {
                    "anchor": 0,
                    "head": 10
                  },
                  "path": "first-light.strudel"
                },
                "prompt": "Make the bass softer. Reply briefly.",
                "turbo": false
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Short answer and optional complete replacement code",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssistResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid prompt, file or cursor offsets",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "Sign in required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "402": {
            "description": "Assist allowance exhausted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "413": {
            "description": "Request body too large",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "429": {
            "description": "Assistant busy (assistant_busy, Retry-After: 2) or provider usage limit",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "502": {
            "description": "Invalid or incomplete model response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "503": {
            "description": "Codex login or RAG unavailable; retrieval index may not be ready",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "504": {
            "description": "Provider timeout",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "security": [
          {
            "session": []
          },
          {
            "browser_session": []
          }
        ]
      }
    },
    "/v1/payments/orders": {
      "get": {
        "operationId": "payment_orders",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Order"
                  }
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": [
          {
            "session": []
          },
          {
            "browser_session": []
          }
        ]
      },
      "post": {
        "operationId": "create_order",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateOrder"
              },
              "example": {
                "document_version": "copy-current-version-from-v1-storefront",
                "plan_id": "plus",
                "price_minor": 39900,
                "request_id": "00000000-0000-4000-8000-000000000001",
                "request_limit": 500
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Order"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": [
          {
            "session": []
          },
          {
            "browser_session": []
          }
        ]
      }
    },
    "/v1/payments/orders/{id}": {
      "get": {
        "operationId": "payment_order",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Order UUID",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Order"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": [
          {
            "session": []
          },
          {
            "browser_session": []
          }
        ]
      }
    },
    "/v1/payments/orders/{id}/cancel": {
      "post": {
        "operationId": "cancel_order",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Order"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": [
          {
            "session": []
          },
          {
            "browser_session": []
          }
        ]
      }
    },
    "/v1/payments/robokassa/fail": {
      "get": {
        "operationId": "payment_fail",
        "responses": {
          "303": {
            "description": "Return to editor; a failed/cancelled browser return never changes the order"
          }
        }
      }
    },
    "/v1/payments/robokassa/result": {
      "post": {
        "summary": "Configure ResultURL as POST. Form values are checked for duplicates before signature verification.",
        "operationId": "robokassa_result",
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "string"
              },
              "example": "OutSum=399.00&InvId=1&Shp_mode=test&Shp_order=00000000-0000-4000-8000-000000000001&SignatureValue=replace-with-sha256-test-password2-signature"
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/payments/robokassa/success": {
      "get": {
        "operationId": "payment_success",
        "responses": {
          "303": {
            "description": "Return to editor; status is verified through the authenticated order API"
          }
        }
      }
    },
    "/v1/storefront": {
      "get": {
        "summary": "Public plans, seller details, purchase terms and payment mode. No credentials.",
        "operationId": "storefront",
        "responses": {
          "200": {
            "description": "Complete storefront for the subscription dialog",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Storefront"
                }
              }
            }
          },
          "503": {
            "description": "Storefront unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApiError": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "AssistRequest": {
        "type": "object",
        "required": [
          "prompt",
          "file"
        ],
        "properties": {
          "audio": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/AudioAttachment",
                "description": "Locally trimmed mono PCM WAV, at most ten seconds; billed separately."
              },
              {
                "type": "null"
              }
            ]
          },
          "file": {
            "$ref": "#/components/schemas/FileContext"
          },
          "prompt": {
            "type": "string"
          },
          "turbo": {
            "type": "boolean",
            "description": "Answer directly without reference lookup or tool calls. Defaults to false."
          }
        },
        "additionalProperties": false
      },
      "AssistResponse": {
        "type": "object",
        "required": [
          "message"
        ],
        "properties": {
          "code": {
            "type": [
              "string",
              "null"
            ],
            "description": "Entire replacement file, or null for an answer without an edit."
          },
          "message": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "AudioAttachment": {
        "type": "object",
        "required": [
          "wav_base64"
        ],
        "properties": {
          "wav_base64": {
            "type": "string",
            "description": "Base64 PCM16 mono WAV at 24 kHz; 0.1–10 seconds. No source file or URL."
          }
        },
        "additionalProperties": false
      },
      "ChangePassword": {
        "type": "object",
        "required": [
          "current_password",
          "new_password"
        ],
        "properties": {
          "current_password": {
            "type": "string"
          },
          "new_password": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "CreateOrder": {
        "type": "object",
        "required": [
          "request_id",
          "plan_id",
          "document_version",
          "price_minor",
          "request_limit"
        ],
        "properties": {
          "accepted": {
            "type": "boolean",
            "description": "Legacy client field; consent is a client-side control and is not stored."
          },
          "document_version": {
            "type": "string"
          },
          "plan_id": {
            "type": "string"
          },
          "price_minor": {
            "type": "integer",
            "format": "int64"
          },
          "request_id": {
            "type": "string"
          },
          "request_limit": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "Credentials": {
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "properties": {
          "password": {
            "type": "string"
          },
          "username": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "Cursor": {
        "type": "object",
        "required": [
          "anchor",
          "head"
        ],
        "properties": {
          "anchor": {
            "type": "integer",
            "description": "Zero-based UTF-16 offset. Different anchor/head values indicate a selection.",
            "minimum": 0
          },
          "head": {
            "type": "integer",
            "description": "Zero-based UTF-16 offset of the active end of the selection (caret).",
            "minimum": 0
          }
        },
        "additionalProperties": false
      },
      "Error": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "FileContext": {
        "type": "object",
        "required": [
          "path",
          "content",
          "cursor"
        ],
        "properties": {
          "content": {
            "type": "string"
          },
          "cursor": {
            "$ref": "#/components/schemas/Cursor"
          },
          "path": {
            "type": "string",
            "description": "Project-relative path; context only, never used for filesystem access."
          }
        },
        "additionalProperties": false
      },
      "Mode": {
        "type": "string",
        "enum": [
          "disabled",
          "test"
        ]
      },
      "Order": {
        "type": "object",
        "required": [
          "id",
          "invoice_id",
          "plan_id",
          "plan_name",
          "price_minor",
          "currency",
          "request_limit",
          "document_version",
          "status",
          "is_test",
          "created_at"
        ],
        "properties": {
          "checkout_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "created_at": {
            "type": "string"
          },
          "currency": {
            "type": "string"
          },
          "document_version": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "invoice_id": {
            "type": "string",
            "description": "Decimal string, not a JavaScript number."
          },
          "is_test": {
            "type": "boolean"
          },
          "paid_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "period_ends_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "plan_id": {
            "type": "string"
          },
          "plan_name": {
            "type": "string"
          },
          "price_minor": {
            "type": "integer",
            "format": "int64"
          },
          "request_limit": {
            "type": "integer",
            "format": "int32"
          },
          "status": {
            "type": "string"
          }
        }
      },
      "PaymentSettings": {
        "type": "object",
        "required": [
          "mode"
        ],
        "properties": {
          "mode": {
            "$ref": "#/components/schemas/Mode"
          }
        }
      },
      "Plan": {
        "type": "object",
        "description": "Public catalog and access policy. Prices use the currency's minor units.",
        "required": [
          "id",
          "name",
          "description",
          "features",
          "price_minor",
          "currency",
          "currency_minor_units",
          "billing_period",
          "audio_enabled",
          "is_default"
        ],
        "properties": {
          "ai_usage_multiplier": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32"
          },
          "audio_enabled": {
            "type": "boolean"
          },
          "billing_period": {
            "type": "string"
          },
          "currency": {
            "type": "string"
          },
