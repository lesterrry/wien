// Eight-bar hook: an upward question, a suspended answer, then home.
import { softness, space } from '../shared/colour.js'
// @default 0.22
const level = 0.22 // @knob step=0.01 min=0 max=0.4
// @default 1.6
const glass = 1.6 // @slider 0.2..4
const voice = {level, glass}

const phrase = cat(
  note("f#4 ~ [a4 c#5] ~ e5 ~ c#5 [~ a4]"),
  note("g#4 ~ f#4 ~ ~ c#5 [b4 a4] ~"),
  note("f#4 ~ a4 ~ e5 [~ f#5] e5 c#5"),
  note("b4 ~ a4 g#4 ~ e4 ~ ~"),
  note("e4 ~ [g#4 b4] ~ c#5 ~ b4 [~ g#4]"),
  note("a4 ~ g#4 ~ ~ e5 [c#5 b4] ~"),
  note("g#4 ~ b4 ~ f#5 [~ e5] c#5 b4"),
  note("a4 g#4 f#4 ~ ~ ~ c#5 ~")
)
const piano = pattern => pattern.s("sine").fm(glass).fmh(2)
  .attack(0.003).decay(0.42 + softness * 0.3).sustain(0).release(0.08)
  .lpf(6500 - softness * 3000).hpf(180)
  .delay(0.19).delaytime(30 / 148).delayfeedback(0.32)
  .room(space).roomsize(2).orbit(1)
  // Accents follow the question; the intervening notes fall back into the room.
  .gain("1 0.72 0.86 0.68 0.96 0.74 0.82 0.62".mul(level))

export const answer = piano(cat(
  note("~ ~ ~ ~ ~ e6 ~ c#6"), note("~ ~ a5 ~ ~ ~ ~ ~"),
  note("~ ~ ~ ~ ~ c#6 ~ a5"), note("~ ~ g#5 ~ ~ ~ ~ ~"),
  note("~ ~ ~ ~ ~ b5 ~ g#5"), note("~ ~ e5 ~ ~ ~ ~ ~"),
  note("~ ~ ~ ~ ~ c#6 ~ b5"), note("a5 ~ ~ ~ ~ ~ ~ ~")
)).gain(level * 0.28).orbit(2)
export default piano(phrase)
