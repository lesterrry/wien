// Close inner voices over changing roots: F#m9 → Dmaj9 → Amaj9 → Eadd9.
import { softness, space } from '../shared/colour.js'
// @default 0.065
const level = 0.065 // @slider 0..0.15
const enabled = true // @default true
const bed = {level, enabled}

export default note("<[a3,c#4,e4,g#4] [a3,c#4,e4,f#4] [g#3,b3,c#4,e4] [g#3,b3,e4,f#4]>")
  .slow(2).s("triangle").attack(0.32).decay(0.8).sustain(0.35).release(1.1)
  .hpf(240).lpf(1200 + softness * 1800)
  .pan(sine.range(-0.3, 0.3).slow(16)).room(space + 0.1).roomsize(3).orbit(3)
  .gain(enabled ? level : 0)
