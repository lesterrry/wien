// Simplified Amen Break grid: https://supertimeultra.com/grooves/amen-break
// Drum sounds adapted from https://github.com/autonomous-ai/openharness/blob/main/store/agents/strudel/skills/strudel/SKILL.md#offline-first-use-synths-not-samples
setcpm(130 / 4)

stack(
  // Kick
  // 1 e & a   2 e & a   3 e & a   4 e & a
  s("sbd").struct(`<
    [x ~ x ~   ~ ~ ~ x   ~ ~ x x   ~ ~ ~ ~]
    [x ~ x ~   ~ ~ ~ x   ~ ~ x x   ~ ~ ~ ~]
    [x ~ x ~   ~ ~ ~ ~   ~ ~ x ~   ~ ~ ~ ~]
    [~ ~ x x   ~ ~ ~ ~   ~ ~ x ~   ~ ~ ~ ~]
  >`).freq(55).pdecay(0.04).decay(0.16).lpf(280).gain(0.65),

  // Snare
  s("white").struct(`<
    [~ ~ ~ ~   x ~ ~ ~   ~ ~ ~ ~   x ~ ~ ~]
    [~ ~ ~ ~   x ~ ~ ~   ~ ~ ~ ~   x ~ ~ ~]
    [~ ~ ~ ~   x ~ ~ ~   ~ ~ ~ ~   ~ ~ x ~]
    [~ ~ ~ ~   x ~ ~ ~   ~ ~ ~ ~   ~ ~ x ~]
  >`)
    .decay(0.11).sustain(0).hpf(1200).gain(0.32),

  // Hat
  s("white").struct("x ~ x ~   x ~ x ~   x ~ x ~   x ~ x ~")
    .decay(0.03).sustain(0).hpf(6500).gain(0.18)
)
