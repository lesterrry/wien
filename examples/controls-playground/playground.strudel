// Import playground: play THIS file and pin it as master in Controls.
// Expand Controls: every imported file gets its own panel, including deep imports.
// kickGain / hatGain / bassGain / leadGain change the actual voices below.
// Toggle each enabled switch to hear which part belongs to that file.
// tone.strudel is shared by bass and lead: waveform changes both voices.

import rhythm from './playground/rhythm.strudel'
import bass from './playground/bass.strudel'
import lead from './playground/lead.strudel'

const tempo = 108 // @slider 70..150
const enabled = true

setcpm(tempo / 4)

// No replacement gain here: each imported voice keeps its own controls.
enabled ? stack(rhythm, bass, lead) : silence
