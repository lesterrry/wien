// Shared dependency: both bass and lead import these actual musical parameters.
// Its controls appear ONCE in the master panel, even though it is imported twice.
const Wave = Object.freeze({
  Sine: 'sine',
  Triangle: 'triangle',
  Saw: 'sawtooth',
})

export const waveform = Wave.Triangle
export const voiceDecay = 0.18 // @slider 0.05..0.6

// Both imports share this one control group.
const tone = {waveform, voiceDecay}
