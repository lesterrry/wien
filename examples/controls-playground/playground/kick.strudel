// Deep import: kickGain is audible while playground.strudel is playing.
const kickGain = 0.28
const kickDecay = 0.16 // @slider 0.05..0.4
const enabled = true

// Compose these controls without repeating them outside the group.
const kickVoice = {kickGain, kickDecay}

export default note("c1*4")
  .s("sine")
  .attack(0.001).decay(kickDecay).sustain(0).release(0.02)
  .gain(enabled ? Math.max(0, kickGain) : 0)
