import { waveform, voiceDecay } from './tone.strudel'

const bassGain = 0.16
const bassCutoff = 600 // @slider 100..4000
const enabled = true

export default note("<c2 ab1 f1 g1>*4")
  .s(waveform)
  .lpf(bassCutoff).attack(0.005).decay(voiceDecay).sustain(0.05).release(0.04)
  .gain(enabled ? Math.max(0, bassGain) : 0)
